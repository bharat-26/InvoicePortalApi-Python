# Copy this file to .env and fill in your own values.

# Supabase PostgreSQL. Username keeps the project ref: postgres.<project-ref>
# Use port 5432 (session pooler), not 6543.
# If the password contains special characters, URL-encode them (@ becomes %40).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.yorlipovlzukuhssckca.supabase.co:5432/postgres

# Any random string of at least 32 characters.
JWT_SECRET=CHANGE-THIS-TO-A-LONG-RANDOM-SECRET-AT-LEAST-32-CHARACTERS
JWT_ISSUER=InvoicePortalAPI
jwt_expiry_minutes=8

# Which front ends may call this API (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:4200


# SMTP credentials used for sending login OTP emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=yourgmail@gmail.com
SMTP_PASSWORD=your_app_password

# OTP expiry time in mins
OTP_EXPIRY_MINUTES=3